{
  "name": "out-source",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "concurrently": "^9.2.1",
    "gsap": "^3.15.0",
    "matter-js": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "tailwindcss": "^4.3.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prestart": "tailwindcss -i ./src/input.css -o ./src/output.css",
    "start": "concurrently \"npm:tailwind:watch\" \"react-scripts start\"",
    "tailwind:watch": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "prebuild": "tailwindcss -i ./src/input.css -o ./src/output.css",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
